{
	"schemaVersion": 1,
	"id": "ccl",
	"version": "${version}",
	"name": "Custom Crafting Library",
	"description": "This is an example description! Tell everyone what your mod is about!",
	"authors": [
		"ARMURIII",
		"eeverest"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/ccl/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"arr.armuriii.ccl.CustomCraftingLibrary"
		],
		"client": [
			"arr.armuriii.ccl.client.CustomCraftingLibraryClient"
		]
	},
	"mixins": [
		"ccl.mixins.json"
	],
	"accessWidener": "ccl.accesswidener",
	"custom": {
		"loom:injected_interfaces": {
			"net/minecraft/class_1856": ["arr/armuriii/ccl/interfaces/ERange"]
		}
	},
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*"
	}
}